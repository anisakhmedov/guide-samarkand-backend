# ---- Core ----
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://localhost:27017/hotel_guide

# ---- Auth secrets (generate real random strings for production) ----
GUEST_JWT_SECRET=change_me_guest_secret
ADMIN_JWT_SECRET=change_me_admin_secret
GUEST_JWT_EXPIRES_IN=365d
ADMIN_JWT_EXPIRES_IN=12h

# ---- Bootstrap super-admin (used by `npm run seed`) ----
SEED_SUPERADMIN_LOGIN=admin
SEED_SUPERADMIN_PASSWORD=admin123
SEED_SUPERADMIN_NAME=Super Admin

# ---- Maps: free OpenStreetMap-based stack, no API key (PLAN.md "Картографический стек") ----
# OSRM routing. The public demo server is fine for development but is rate-limited and
# generally only serves the "driving" profile — for real walking directions in production,
# point this at a self-hosted OSRM/Valhalla instance. Falls back to a straight-line
# (haversine) distance/time estimate whenever a route request fails.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE_WALKING=foot
OSRM_PROFILE_DRIVING=driving

# Nominatim geocoding (admin "search by address" helper). Usage policy requires identifying
# the calling application — set this to something real before any non-trivial usage.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=samarkand-hotel-guide/1.0 (contact: you@example.com)

# Links guests are sent to at the "leave a review" step. Replace with the hotel's real listings.
REVIEW_LINK_GOOGLE=https://maps.google.com/?cid=REPLACE_ME
REVIEW_LINK_YANDEX=https://yandex.com/maps/org/REPLACE_ME
REVIEW_LINK_2GIS=https://2gis.com/REPLACE_ME

# ---- File storage ----
# "local" stores uploads in ./uploads and serves them from /uploads.
# Swap to an S3-compatible adapter later without touching callers of UploadService.
STORAGE_DRIVER=local
